# ─────────────────────────────────────────────────────────────────────────────
# cdc-read-model — environment template
#
# This file is the SINGLE SOURCE OF TRUTH for host ports and connection strings.
# `scripts/bootstrap.sh` copies it to `.env` (which is gitignored). Never hardcode
# a connection string in code — read it from here. Change a port ONCE, here.
# ─────────────────────────────────────────────────────────────────────────────

# ── Host ports (what you reach from your Mac) ────────────────────────────────
# All standard defaults, chosen to not collide. If one is taken on your machine,
# change it here and re-run `make up`.
POSTGRES_PORT=5432
KAFKA_PORT=9092          # broker bootstrap (external listener)
KAFKA_CONNECT_PORT=8083  # Kafka Connect / Debezium REST API
KAFKA_UI_PORT=8080       # kafka-ui web console
ELASTICSEARCH_PORT=9200  # Elasticsearch REST
REDIS_PORT=6379
API_PORT=8000            # FastAPI tracking service (epic 02)

# ── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_USER=cdc
POSTGRES_PASSWORD=cdc
POSTGRES_DB=genomics
# App / tooling connection string (used by the API, consumers, verifier, smoke tests)
DATABASE_URL=postgresql://cdc:cdc@localhost:5432/genomics

# ── Kafka ────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONNECT_URL=http://localhost:8083

# ── Elasticsearch ────────────────────────────────────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
